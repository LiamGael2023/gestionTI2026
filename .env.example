# Configuracion del Chatbot IA
# Copiar como .env y completar valores

# Servicio: "opencode" (OpenCode Go) o "deepseek" (API directa DeepSeek)
# OpenCode Go endpoint: /zen/go/v1/chat/completions
CHAT_SERVICE=opencode

# Opcion A: OpenCode Go (default, suscripcion $10/mes)
OPENCODE_API_KEY=sk-tu-api-key
OPENCODE_MODEL=deepseek-v4-flash

# Opcion B: DeepSeek API directa (cambiar CHAT_SERVICE=deepseek arriba)
# DEEPSEEK_API_KEY=sk-tu-api-key-deepseek
# DEEPSEEK_MODEL=deepseek-chat

# SSL verification (deshabilitar solo si hay problemas de certificados)
# CHAT_SSL_VERIFY=false
